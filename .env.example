# Copy this file to  .env  and fill in your values.  NEVER paste your password in chat.
# The .env file stays on your Mac and is git-ignored.

# --- IMAP inbox that RECEIVES the eBay "you made the sale" emails ---
# eBay mails go to alrezaenterprise@outlook.com, which forwards to sales2@alrezaenterprise.com (GoDaddy).
# So watch the GoDaddy box that receives the forward:
IMAP_HOST=imap.secureserver.net
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=sales2@alrezaenterprise.com
IMAP_PASS=your-mailbox-password-here
IMAP_MAILBOX=INBOX

# How many days back to scan on each run
LOOKBACK_DAYS=7

# Exporter identity used in the drafted message
EXPORTER_EMAIL=sales@alrezaenterprise.com
OWN_DOMAIN=alrezaenterprise.com

# Passphrase that encrypts the drafts for your phone (you'll type this once on the phone).
# Only needed for the real run / deploy, not for --dry test.
APP_PASSPHRASE=choose-a-passphrase
